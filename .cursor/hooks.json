{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard_shell.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/guard_read.py",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
