modules = ["python-base-3.13", "nodejs-24"]
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PostgreSQL"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "PostgreSQL"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "postgres -D /home/runner/workspace/.pg/data -k /tmp -p 5432 -c listen_addresses=127.0.0.1"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 report_server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[[ports]]
localPort = 5000
externalPort = 80
